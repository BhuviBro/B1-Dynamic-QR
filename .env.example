# Firebase Client Configuration (Frontend)
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Optional Custom Domain for QR codes (defaults to current window.location.origin if omitted)
# Example: https://cards.b1.com
VITE_PUBLIC_DOMAIN=

# Netlify Serverless Function Firebase Admin Config (Production)
# Option A: Full Service Account JSON as a single-line string
FIREBASE_SERVICE_ACCOUNT=

# Option B: Individual Service Account fields
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-project-id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgk..."
